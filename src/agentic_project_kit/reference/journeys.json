{
  "schema_version": 1,
  "kind": "agentic_kit_journey_contracts",
  "law": "G4 (owner plan 2026-11-13): fixed workflows run as machine contracts against the built wheel in a disposable workspace with a local bare origin. Measures per journey: approvals (owner consents, exact baseline) and blocked (every Kit step ends PASS, PLANNED or AWAITING_APPROVAL; baseline 0). A worse measure fails CI. Offline the journeys stop at the GitHub boundary (work finish as dry run); J2 emulates merge and post-merge closeout with git and handoff steps. Approvals count signed executions and steps with effects beyond none/fetch/push/network_read (owner decision 2026-11-13).",
  "journeys": [
    {
      "id": "J1",
      "title": "Start work, change a file, finish",
      "approvals": 1,
      "machine": {
        "fixture": "external_manifest",
        "origin": true,
        "covers": "J1: work start from main, one changed file, work finish plans commit, push, PR, merge and closeout without a BLOCKED step",
        "steps": [
          {"run": ["agentic-kit", "work", "start", "--branch", "feat/j1-journey", "--from-ref", "main", "--json"], "expect": {"returncode": 0, "json": {"result_status": "PASS"}}},
          {"expect": {"stdout_equals": "feat/j1-journey"}, "run": ["git", "branch", "--show-current"]},
          {"write": {"path": "notes/j1.md", "text": "J1 journey change\n"}},
          {"run": ["agentic-kit", "work", "finish", "--branch", "feat/j1-journey", "--title", "J1 journey", "--message", "J1 journey", "--path", "notes/j1.md", "--json"], "expect": {"returncode": 0, "json": {"result_status": "PLANNED"}}},
          {"assert": {"exists": ["notes/j1.md"]}}
        ]
      }
    },
    {
      "id": "J2",
      "title": "Adopt a Kit release, then a release with only that adoption",
      "approvals": 2,
      "machine": {
        "fixture": "external_adoption",
        "origin": true,
        "covers": "J2 (V1, V6, V11): in a curated workspace, a signed kit update installs real wheels from a loopback index and writes the adoption line (K4); work finish plans to publish it; after the merge the release is ready with only that line and without a BLOCKED step. Merge and post-merge closeout run as git and handoff steps until the live run covers the GitHub part; the post-merge handoff refresh leaves no tracked change (observed in run 0082), which the contract asserts.",
        "steps": [
          {"run": ["agentic-kit", "work", "start", "--branch", "chore/kit-adoption", "--from-ref", "main", "--json"], "expect": {"returncode": 0, "json": {"result_status": "PASS"}}},
          {"run": ["agentic-kit", "kit", "update", "--version", "{adoption_version}", "--json"], "expect": {"returncode": 0, "json": {"result_status": "AWAITING_APPROVAL"}}, "capture": {"signature": "approval_signature"}},
          {"run": ["agentic-kit", "kit", "update", "--version", "{adoption_version}", "--execute", "--expected-signature", "{signature}", "--json"], "expect": {"returncode": 0, "json": {"result_status": "PASS", "installed_version": "{adoption_version}"}}},
          {"run": ["git", "add", "-A"], "expect": {"returncode": 0}},
          {"run": ["git", "commit", "-m", "Adopt Agentic Project Kit {adoption_version}"], "expect": {"returncode": 0}},
          {"run": ["agentic-kit", "work", "finish", "--branch", "chore/kit-adoption", "--title", "Adopt Agentic Project Kit {adoption_version}", "--message", "Adopt Agentic Project Kit {adoption_version}", "--json"], "expect": {"returncode": 0, "json": {"result_status": "PLANNED"}, "stdout_contains": "publish-existing-commits"}},
          {"run": ["git", "switch", "main"], "expect": {"returncode": 0}},
          {"run": ["git", "merge", "--squash", "chore/kit-adoption"], "expect": {"returncode": 0}},
          {"run": ["git", "commit", "-m", "Adopt Agentic Project Kit {adoption_version} (#2)"], "expect": {"returncode": 0}},
          {"run": ["git", "push", "origin", "main"], "expect": {"returncode": 0}},
          {"run": ["agentic-kit", "rules", "acknowledge"], "expect": {"returncode": 0}},
          {"run": ["agentic-kit", "transfer", "chat-switch-complete", "--json"], "expect": {"returncode": 0, "json": {"result_status": "PASS"}}},
          {"run": ["git", "status", "--short", "--untracked-files=no"], "expect": {"returncode": 0, "stdout_equals": ""}},
          {"run": ["agentic-kit", "release", "ready", "--version", "0.1.1", "--date", "2026-11-13", "--json"], "expect": {"returncode": 0, "json": {"result_status": "PASS"}}},
          {"run": ["git", "status", "--short", "--untracked-files=no"], "expect": {"returncode": 0, "stdout_equals": ""}}
        ]
      }
    },
    {
      "id": "J3",
      "title": "Change already committed, then finish",
      "approvals": 1,
      "machine": {
        "fixture": "external_manifest",
        "origin": true,
        "covers": "J3 (V8): a change committed by hand on the work branch; work finish without --path plans to publish the existing commit (K1) without a BLOCKED step",
        "steps": [
          {"run": ["agentic-kit", "work", "start", "--branch", "feat/j3-journey", "--from-ref", "main", "--json"], "expect": {"returncode": 0, "json": {"result_status": "PASS"}}},
          {"write": {"path": "notes/j3.md", "text": "J3 journey change\n"}},
          {"run": ["git", "add", "notes/j3.md"], "expect": {"returncode": 0}},
          {"run": ["git", "commit", "-m", "J3 journey"], "expect": {"returncode": 0}},
          {"run": ["agentic-kit", "work", "finish", "--branch", "feat/j3-journey", "--title", "J3 journey", "--message", "J3 journey", "--json"], "expect": {"returncode": 0, "json": {"result_status": "PLANNED"}, "stdout_contains": "publish-existing-commits"}}
        ]
      }
    }
  ],
  "pending": [
    {"id": "J4", "reason": "Release interrupted after B4 and resumed: needs K7 (owner plan slice 4)."},
    {"id": "J5", "reason": "Curated release with exactly one line: owner plan slice 4."}
  ]
}
